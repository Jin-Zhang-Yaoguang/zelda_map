{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "dataVersion": {
      "type": "string",
      "minLength": 1
    },
    "game": {
      "const": "botw"
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "$ref": "#/$defs/localized"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      },
      "minItems": 15,
      "maxItems": 15
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "retrievedAt": {
            "type": "string",
            "minLength": 1
          },
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "retrievedAt"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "shrines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shrine"
      },
      "minItems": 136,
      "maxItems": 136
    },
    "towers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tower"
      },
      "minItems": 15,
      "maxItems": 15
    }
  },
  "required": [
    "schemaVersion",
    "dataVersion",
    "game",
    "generatedAt",
    "regions",
    "sources",
    "shrines",
    "towers"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.zelda-map/schema/shrines.v1.json",
  "$defs": {
    "localized": {
      "type": "object",
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        },
        "ja": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "zh",
        "en",
        "ja"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "verified",
            "unverified",
            "conflict"
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "displayNote": {
          "$ref": "#/$defs/localized"
        }
      },
      "required": [
        "status",
        "sourceIds"
      ],
      "additionalProperties": false
    },
    "shrine": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^Dungeon(0[0-9]{2}|1[0-2][0-9]|13[0-5])$"
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "$ref": "#/$defs/localized"
        },
        "trial": {
          "$ref": "#/$defs/localized"
        },
        "regionId": {
          "type": "string",
          "minLength": 1
        },
        "dlc": {
          "type": "boolean"
        },
        "position": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y",
            "z"
          ],
          "additionalProperties": false
        },
        "safe": {
          "type": "object",
          "properties": {
            "summary": {
              "$ref": "#/$defs/localized"
            },
            "prerequisite": {
              "$ref": "#/$defs/localized"
            }
          },
          "required": [
            "summary",
            "prerequisite"
          ],
          "additionalProperties": false
        },
        "detail": {
          "type": "object",
          "properties": {
            "intro": {
              "$ref": "#/$defs/localized"
            },
            "prerequisites": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/localized"
              },
              "minItems": 0
            },
            "supplies": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/localized"
              },
              "minItems": 0
            },
            "walkthrough": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/localized"
              },
              "minItems": 1
            }
          },
          "required": [
            "intro",
            "prerequisites",
            "supplies",
            "walkthrough"
          ],
          "additionalProperties": false
        },
        "verification": {
          "type": "object",
          "properties": {
            "name": {
              "$ref": "#/$defs/evidence"
            },
            "position": {
              "$ref": "#/$defs/evidence"
            },
            "region": {
              "$ref": "#/$defs/evidence"
            },
            "safe": {
              "$ref": "#/$defs/evidence"
            },
            "intro": {
              "$ref": "#/$defs/evidence"
            },
            "prerequisites": {
              "$ref": "#/$defs/evidence"
            },
            "supplies": {
              "$ref": "#/$defs/evidence"
            },
            "walkthrough": {
              "$ref": "#/$defs/evidence"
            }
          },
          "required": [
            "name",
            "position",
            "region",
            "safe",
            "intro",
            "prerequisites",
            "supplies",
            "walkthrough"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "sourceId",
        "name",
        "trial",
        "regionId",
        "dlc",
        "position",
        "safe",
        "detail",
        "verification"
      ],
      "additionalProperties": false
    },
    "tower": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^Tower(0[1-9]|1[0-5])$"
        },
        "name": {
          "$ref": "#/$defs/localized"
        },
        "position": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y",
            "z"
          ],
          "additionalProperties": false
        },
        "regionId": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "const": "map-static"
        },
        "verification": {
          "type": "object",
          "properties": {
            "name": {
              "$ref": "#/$defs/evidence"
            },
            "position": {
              "$ref": "#/$defs/evidence"
            },
            "region": {
              "$ref": "#/$defs/evidence"
            }
          },
          "required": [
            "name",
            "position",
            "region"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "name",
        "position",
        "regionId",
        "sourceId",
        "verification"
      ],
      "additionalProperties": false
    }
  }
}
